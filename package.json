{
  "name": "pali-canon-mcp",
  "mcpName": "io.github.DaniilKi/pali-canon",
  "version": "2.1.0",
  "description": "The Pāli Canon for Claude: whole Tipiṭaka offline (VRI), citation and PTS resolution, English translations with mirrors, Pāli dictionary.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "pali-canon-mcp": "server/index.cjs"
  },
  "files": [
    "server",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.cjs",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run build && npm test && npm run audit",
    "pack:desktop": "node scripts/pack-desktop.mjs",
    "audit": "node scripts/audit.mjs",
    "corpus:check": "node scripts/corpus-check.mjs",
    "outage": "node scripts/outage.mjs",
    "coverage": "node scripts/coverage.mjs",
    "serve": "node server/http.cjs",
    "loadtest": "node scripts/loadtest.mjs",
    "linkcheck": "node scripts/linkcheck.mjs",
    "registry:check": "node scripts/check-server-json.mjs --publish",
    "evals": "node evals/run.mjs",
    "eval": "node evals/run.mjs",
    "audit:installed": "node scripts/audit-installed.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DaniilKi/pali-canon-claude.git"
  },
  "bugs": {
    "url": "https://github.com/DaniilKi/pali-canon-claude/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "pali",
    "tipitaka",
    "buddhism",
    "theravada"
  ]
}
